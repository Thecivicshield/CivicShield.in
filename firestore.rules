rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Campaign collection documents containing persistent site state
    match /campaign/{document} {
      allow read: if true;
      allow write: if true;
    }
    
    // User accounts or audit logs
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Default catch-all denies unauthenticated random access
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
